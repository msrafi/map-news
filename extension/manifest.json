{
  "manifest_version": 3,
  "name": "Map News Collector",
  "version": "1.4.0",
  "description": "Collects visible posts from an X timeline and exports them as news.json for the Map News app.",
  "permissions": ["storage", "downloads", "alarms", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Map News Collector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["places.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
